# Settings for the container: docker run --env-file <this file>.
# Copy to ~/.acro-check/.env on the server, fill in the values, then: chmod 600 ~/.acro-check/.env
# One KEY=value per line, no quotes.

# Data center URL: the start of the console's address, up to .com
ACRONIS_BASE_URL=
# API client: Cyber Console > Settings > General settings > API clients
ACRONIS_CLIENT_ID=
ACRONIS_CLIENT_SECRET=
# The channel's incoming webhook (Teams Workflows, Slack or Discord)
ACRONIS_ALERT_WEBHOOK=
# Public address of the Clear alert button (your reverse proxy in front of port 8765)
ACRO_CLEAR_URL=
# Time zone for card times, e.g. America/New_York
TZ=
